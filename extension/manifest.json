{
  "manifest_version": 3,
  "name": "Pillole dal vault",
  "version": "0.1.1",
  "description": "Un concetto dalle tue note Obsidian, ogni tanto. Scorta locale con Codex CLI e notifiche nei giorni lavorativi.",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Pillole dal vault",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "app.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
